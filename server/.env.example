# LinkVideo.VPNSync example configuration. Never commit real secrets.

VPNSYNC_BIND_HOST=127.0.0.1
VPNSYNC_BIND_PORT=8787
VPNSYNC_API_TOKEN=replace-with-a-long-random-token

DATABASE_URL=postgresql://linkvideo_vpnsync:replace-me@127.0.0.1:5432/linkvideo_vpn
VPNSYNC_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret

# RouterOS credentials should be supplied through a root-readable server config,
# not embedded in the desktop application or committed to Git.
ROUTEROS_USERNAME=replace-me
ROUTEROS_PASSWORD=replace-me
ROUTEROS_API_PORT=8728
ROUTEROS_TIMEOUT=6.0
